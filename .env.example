# ========================================
# SERVER CONFIGURATION
# ========================================
# Host and port where your server will run
SERVER_HOST=localhost
SERVER_PORT=8000

# ========================================
# CACHE CONFIGURATION
# ========================================
# TTL (time-to-live) for cache entries
CACHE_TTL=5m

# Maximum number of items in cache
CACHE_MAX_SIZE=1000

# ========================================
# EXTERNAL API CONFIGURATION
# ========================================
# Base URL for REST Countries API
REST_COUNTRIES_API_URL=https://restcountries.com/v3.1

# Timeout for external API requests
API_TIMEOUT=10s

# ========================================
# LOGGER CONFIGURATION
# ========================================
# Logger Configuration
LOG_ENV=development         # development, staging, production
LOG_LEVEL=info              # debug, info, warn, error, critical
LOG_FORMAT=json             # json or console
LOG_MODE=console,file       # comma-separated: console, file, kafka
LOG_FILE_PATH=logs/app.log  # log file path
LOG_MAX_SIZE_MB=10          # max size per log file
LOG_MAX_BACKUPS=5           # number of rotated backup files
LOG_MAX_AGE_DAYS=7          # max age for log files
