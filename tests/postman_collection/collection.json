		{
			"name": "3. Cache Testing",
			"item": [
				{
					"name": "First Request (Cache Miss)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Store response time for comparison",
									"pm.environment.set(\"first_response_time\", pm.response.responseTime);",
									"",
									"pm.test(\"Response time recorded\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/countries/search?name=France",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"countries",
								"search"
							],
							"query": [
								{
									"key": "name",
									"value": "France"
								}
							]
						},
						"description": "**Test Case 5:** Cache miss scenario\n\n**Expected:**\n- First request → fetch from API\n- Slower response time\n- Data cached for next request"
					},
					"response": []
				},
				{
					"name": "Second Request (Cache Hit)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Cache hit is faster\", function () {",
									"    var firstTime = pm.environment.get(\"first_response_time\");",
									"    var secondTime = pm.response.responseTime;",
									"    ",
									"    console.log(\"First request: \" + firstTime + \"ms\");",
									"    console.log(\"Second request: \" + secondTime + \"ms\");",
									"    ",
									"    // Cache hit should be faster (usually 30x faster!)",
									"    // But we'll be lenient and just check it's fast",
									"    pm.expect(secondTime).to.be.below(1000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/countries/search?name=France",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"countries",
								"search"
							],
							"query": [
								{
									"key": "name",
									"value": "France"
								}
							]
						},
						"description": "**Test Case 6:** Cache hit scenario\n\n**Expected:**\n- Same request → served from cache\n- Much faster response (typically 30x faster)\n- Same data as first request"
					},
					"response": []
				},
				{
					"name": "Check Metrics (Cache Stats)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Metrics show cache activity\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.cache).to.have.property('hits');",
									"    pm.expect(jsonData.data.cache).to.have.property('misses');",
									"    pm.expect(jsonData.data.cache).to.have.property('size');",
									"    pm.expect(jsonData.data.cache).to.have.property('evictions');",
									"});",
									"",
									"pm.test(\"Cache has at least 1 hit\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.cache.hits).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/metrics",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"metrics"
							]
						},
						"description": "**Test Case 7:** Verify cache metrics\n\n**Expected:**\n- hits > 0 (from previous cache hit)\n- misses > 0 (from previous cache miss)\n- size shows current cache entries"
					},
					"response": []
				}
			],
			"description": "Tests cache hit/miss scenarios and performance"
		},
