{
	"info": {
		"_postman_id": "country-search-api-v1",
		"name": "Country Search API - Complete Test Suite",
		"description": "Comprehensive test collection for Country Search API with caching\n\n## Features Tested:\n- ✅ Search countries by name\n- ✅ URL encoding for special characters\n- ✅ Cache hit/miss scenarios\n- ✅ Error handling (validation, not found)\n- ✅ Health checks\n- ✅ Metrics tracking\n- ✅ Concurrent requests\n- ✅ Edge cases\n\n## Setup:\n1. Import this collection\n2. Set environment variable: `base_url = http://localhost:8000`\n3. Start the server: `./scripts/build.sh run`\n4. Run collection\n\n## Coverage:\nThis collection tests every endpoint and edge case in the project.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "12345"
	},
	"item": [
		{
			"name": "1. Basic Functionality",
			"item": [
				{
					"name": "Search Country - India",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test status code",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test response structure",
									"pm.test(\"Response has success=true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"// Test country data",
									"pm.test(\"Country data is present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('name');",
									"    pm.expect(jsonData.data).to.have.property('capital');",
									"    pm.expect(jsonData.data).to.have.property('currency');",
									"    pm.expect(jsonData.data).to.have.property('population');",
									"});",
									"",
									"// Test specific values",
									"pm.test(\"Country is India\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.name).to.eql('India');",
									"    pm.expect(jsonData.data.capital).to.eql('New Delhi');",
									"});",
									"",
									"// Test response time",
									"pm.test(\"Response time < 2000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/countries/search?name=India",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"countries",
								"search"
							],
							"query": [
								{
									"key": "name",
									"value": "India",
									"description": "Country name to search"
								}
							]
						},
						"description": "**Test Case 1:** Basic country search\n\n**Expected:**\n- Status: 200\n- Success: true\n- Data contains: name, capital, currency, population\n- Country: India\n- Capital: New Delhi"
					},
					"response": []
				},
